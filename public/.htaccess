# React Router SPA fallback for LiteSpeed / Apache.
# Vite copies this file to the dist root on build.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fallback if rewrite is restricted on the host
ErrorDocument 404 /index.html
